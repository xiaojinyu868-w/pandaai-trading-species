 "quickref": {
  "front": {
   "title": "一季怎么走",
   "steps": [
    "领预算：每人拿 1 研究点。",
    "赶路：掷两颗骰子选一个点数，1–5 落小格，6 直接到门口并多拿 1 研究点。",
    "名场面：全员进门，走完六步。",
    "驿站：拿一枚本季物种币，走到下一季起点。"
   ],
   "scene_steps": [
    "盲入场：读场景牌，认出来了就在委托单写事件名。",
    "开证据：每轮花 1 研究点看一张。",
    "做决定：在委托单勾选项、理由和计划，扣在玩家板上。",
    "亮牌：倒数三二一，一起翻。",
    "快进：翻快进牌，结算第一段，再决定一次。",
    "揭幕：翻揭幕牌，结算第二段，记方法星。"
   ]
  },
  "back": {
   "title": "物种图标从哪来",
   "note": "第一场揭幕后再翻看",
   "rows": [
    [
     "理由勾量价",
     "猎豹 ×2"
    ],
    [
     "理由勾数据",
     "大象 ×2"
    ],
    [
     "理由勾消息、跟别人",
     "狐獴 ×2"
    ],
    [
     "用规则牌并照做",
     "狐狸 ×2"
    ],
    [
     "选观望且理由不是直觉、看不懂",
     "猫头鹰 ×2"
    ],
    [
     "第一张看的证据",
     "对应物种 ×1"
    ],
    [
     "机会牌的答案",
     "看牌底"
    ]
   ],
   "stars": [
    "看了证据 ★，两张及以上不同 ★★",
    "理由一致 ★",
    "计划照做 ★"
   ]
  }
 },
 "prologue": {
  "title": "序章 · 1720 南海泡沫",
  "lines": [
   "1720 年，伦敦。一家叫南海公司的股票半年涨了八倍。",
   "人人都在买，连大科学家牛顿也买了。他先赚了一笔，卖掉，又在更高的价钱买回去。",
   "泡沫破了。相传牛顿亏了大约两万英镑，他说：我能算出天体的运行，却算不出人们的疯狂。",
   "所以这个游戏不比谁赚得多。我们看你怎么做决定。"
  ],
  "steps": [
   "一人朗读这张牌。",
   "把 6 张物种牌摊开（海狸是隐藏物种，不摊）。",
   "每人在终局档案卡上偷偷圈一个“我觉得我是”。"
  ]
 },
 "station": {
  "title": "驿站",
  "lines": [
   "数一数这一季委托单上的物种图标，拿一枚最多的那种物种币。",
   "平局或不同意：抽一张补测牌。",
   "认出来的场景：币放空心面，算半枚。"
  ]
 },
