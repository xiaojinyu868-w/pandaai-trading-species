 "boundary": 107.74,
 "captions": [
  {
   "start": 0.9,
   "end": 3.155,
   "text": "1720 年，南海泡沫。",
   "film": "promo"
  },
  {
   "start": 3.155,
   "end": 7.289,
   "text": "相传牛顿先赚了一笔，又在更高的价格买了回去，",
   "film": "promo"
  },
  {
   "start": 7.289,
   "end": 8.98,
   "text": "最后亏掉两万英镑。",
   "film": "promo"
  },
  {
   "start": 9.83,
   "end": 13.318,
   "text": "这些名场面，现在可以亲手再玩一遍：",
   "film": "promo"
  },
  {
   "start": 13.318,
   "end": 16.19,
   "text": "2015 年人人借钱买股票，",
   "film": "promo"
  },
  {
   "start": 16.19,
   "end": 19.267,
   "text": "2020 年美股十天熔断四次，",
   "film": "promo"
  },
  {
   "start": 19.267,
   "end": 22.55,
   "text": "2024 年国庆前全民排队开户。",
   "film": "promo"
  },
  {
   "start": 23.4,
   "end": 28.006,
   "text": "每一场，你都站在当年那个路口：追，还是等？",
   "film": "promo"
  },
  {
   "start": 28.006,
   "end": 30.2,
   "text": "借钱加仓，还是先跑？",
   "film": "promo"
  },
  {
   "start": 31.45,
   "end": 33.864,
   "text": "不是韭菜，那你是哪一种？",
   "film": "promo"
  },
  {
   "start": 33.864,
   "end": 35.272,
   "text": "交易物种起源。",
   "film": "promo"
  },
  {
   "start": 35.272,
   "end": 38.49,
   "text": "一盒桌游，一部手机，同一个游戏。",
   "film": "promo"
  },
  {
   "start": 39.94,
   "end": 44.111,
   "text": "名字和日期都藏起来，只给你当时能看到的走势和处境。",
   "film": "promo"
  },
  {
   "start": 44.111,
   "end": 45.78,
   "text": "先猜猜，这是哪一年？",
   "film": "promo"
  },
  {
   "start": 46.63,
   "end": 49.415,
   "text": "翻线索，定计划，然后出手。",
   "film": "promo"
  },
  {
   "start": 49.415,
   "end": 51.556,
   "text": "手指按着，就是拿着；",
   "film": "promo"
  },
  {
   "start": 51.556,
   "end": 53.27,
   "text": "松开，就是卖掉。",
   "film": "promo"
  },
  {
   "start": 54.42,
   "end": 56.257,
   "text": "涨多了，有人借钱给你；",
   "film": "promo"
  },
  {
   "start": 56.257,
   "end": 58.427,
   "text": "跌停那天，想卖也卖不出去。",
   "film": "promo"
  },
  {
   "start": 58.427,
   "end": 62.1,
   "text": "两位 AI 对手，在同一张图上和你一起买卖。",
   "film": "promo"
  },
  {
   "start": 63.15,
   "end": 65.873,
   "text": "揭幕：原来是 2015 年。",
   "film": "promo"
  },
  {
   "start": 65.873,
   "end": 68.013,
   "text": "真实走势一根根长出来，",
   "film": "promo"
  },
  {
   "start": 68.013,
   "end": 73.07,
   "text": "行情和结算都来自 Panda Data 的真实日线。",
   "film": "promo"
  },
  {
   "start": 74.12,
   "end": 77.501,
   "text": "玩完，AI 给你复盘：在哪儿买的，扛了多深，",
   "film": "promo"
  },
  {
   "start": 77.501,
   "end": 79.96,
   "text": "说好跌 5% 就走，最后走没走。",
   "film": "promo"
  },
  {
   "start": 81.01,
   "end": 83.268,
   "text": "它还会告诉你像哪种交易物种；",
   "film": "promo"
  },
  {
   "start": 83.268,
   "end": 85.686,
   "text": "再把你的习惯写成一句交易规则，",
   "film": "promo"
  },
  {
   "start": 85.686,
   "end": 89.073,
   "text": "一键复制进 PandaAI 的 Qube，",
   "film": "promo"
  },
  {
   "start": 89.073,
   "end": 91.33,
   "text": "拿历史数据回测，看它灵不灵。",
   "film": "promo"
  },
  {
   "start": 92.38,
   "end": 95.02,
   "text": "换一个选择，结果和复盘当场就变。",
   "film": "promo"
  },
  {
   "start": 97.78,
   "end": 101.096,
   "text": "桌上的八十八个二维码，接回同一部手机。",
   "film": "promo"
  },
  {
   "start": 101.096,
   "end": 103.54,
   "text": "接下来，看看这盒桌游怎么玩。",
   "film": "promo"
  },
  {
   "start": 111.09,
   "end": 113.478,
   "text": "这是交易物种起源的桌游。",
   "film": "board"
  },
  {
   "start": 113.478,
   "end": 116.862,
   "text": "一到五个人，展台快玩一场十五分钟，",
   "film": "board"
  },
  {
   "start": 116.862,
   "end": 119.25,
   "text": "完整一局六十到九十分钟。",
   "film": "board"
  },
  {
   "start": 120.1,
   "end": 126.031,
   "text": "棋盘是一圈四季：春入场，夏狂热，秋松动，冬危机。",
   "film": "board"
  },
  {
   "start": 126.031,
   "end": 131.22,
   "text": "每人拿一块玩家板，资金二十万，一个研究点。",
   "film": "board"
  },
  {
   "start": 132.07,
   "end": 137.656,
   "text": "开局前，先在档案卡上偷偷圈一个“我觉得我是”的物种，",
   "film": "board"
  },
  {
   "start": 137.656,
   "end": 139.59,
   "text": "扣好，最后再翻开。",
   "film": "board"
  },
  {
   "start": 140.44,
   "end": 145.916,
   "text": "每一季，掷两颗骰子，挑一个点数往前走：补给站、机会、",
   "film": "board"
  },
  {
   "start": 145.916,
   "end": 150.76,
   "text": "研究所、数据港口、冷静亭，每一格都有自己的事。",
   "film": "board"
  },
  {
   "start": 151.61,
   "end": 154.092,
   "text": "走到门口，推开名场面之门。",
   "film": "board"
  },
  {
   "start": 154.092,
   "end": 158.865,
   "text": "翻开场景牌，只有一张走势图和当时的处境，没有名字，",
   "film": "board"
  },
  {
   "start": 158.865,
   "end": 160.01,
   "text": "也没有日期。",
   "film": "board"
  },
  {
   "start": 160.86,
   "end": 162.465,
   "text": "觉得认出来了？",
   "film": "board"
  },
  {
   "start": 162.465,
   "end": 165.674,
   "text": "写下事件名，放一枚认出令牌。",
   "film": "board"
  },
  {
   "start": 165.674,
   "end": 170.717,
   "text": "这一场的钱不按自己的选项算，记其他人的平均，",
   "film": "board"
  },
  {
   "start": 170.717,
   "end": 172.78,
   "text": "物种币也只算半枚。",
   "film": "board"
  },
  {
   "start": 173.63,
   "end": 179.033,
   "text": "接着花研究点看证据：量价、数据、消息，还有锦囊。",
   "film": "board"
  },
  {
   "start": 179.033,
   "end": 183.31,
   "text": "研究点不够看全，先看哪一张，也是线索。",
   "film": "board"
  },
  {
   "start": 184.16,
   "end": 189.051,
   "text": "然后撕一张这一季的委托单：勾选项，勾理由，",
   "film": "board"
  },
  {
   "start": 189.051,
   "end": 190.914,
   "text": "再勾跌了怎么办。",
   "film": "board"
  },
  {
   "start": 190.914,
   "end": 194.64,
   "text": "对折扣好，三、二、一，一起翻开。",
   "film": "board"
  },
  {
   "start": 195.49,
   "end": 199.907,
   "text": "同样选了等，一个在等数据，一个是看不懂。",
   "film": "board"
  },
  {
   "start": 199.907,
   "end": 205.65,
   "text": "理由不同，拿到的物种图标就不同，最后像的动物也不同。",
   "film": "board"
  },
  {
   "start": 206.8,
   "end": 209.453,
   "text": "翻开快进牌，结算第一段。",
   "film": "board"
  },
  {
   "start": 209.453,
   "end": 214.095,
   "text": "每一场都有一个招牌机制：春天是开户排队条，",
   "film": "board"
  },
  {
   "start": 214.095,
   "end": 218.295,
   "text": "夏天是卖出窗口和跌停锁，秋天是抱团圈，",
   "film": "board"
  },
  {
   "start": 218.295,
   "end": 223.6,
   "text": "冬天是熔断沙漏，全桌三十秒，不许说话，不许碰牌。",
   "film": "board"
  },
  {
   "start": 224.55,
   "end": 227.462,
   "text": "最后翻开揭幕牌，结算第二段；",
   "film": "board"
  },
  {
   "start": 227.462,
   "end": 231.83,
   "text": "扫上面的码，真实走势在手机上一根根长出来。",
   "film": "board"
  },
  {
   "start": 232.98,
   "end": 237.423,
   "text": "走到驿站，数一数委托单上的图标，领一枚物种币。",
   "film": "board"
  },
  {
   "start": 237.423,
   "end": 240.9,
   "text": "四季下来，哪种币最多，你就像哪一种。",
   "film": "board"
  },
  {
   "start": 241.75,
   "end": 245.035,
   "text": "终局分两本账：资金账看赚了多少；",
   "film": "board"
  },
  {
   "start": 245.035,
   "end": 249.14,
   "text": "方法账看你有没有看证据、理由对不对得上、",
   "film": "board"
  },
  {
   "start": 249.14,
   "end": 250.782,
   "text": "计划有没有照做。",
   "film": "board"
  },
  {
   "start": 250.782,
   "end": 252.63,
   "text": "两样加起来定胜负。",
   "film": "board"
  },
  {
   "start": 253.48,
   "end": 256.512,
   "text": "翻开档案卡背面的决策树，从上往下，",
   "film": "board"
  },
  {
   "start": 256.512,
   "end": 259.008,
   "text": "第一个符合的就是你的任务牌，",
   "film": "board"
  },
  {
   "start": 259.008,
   "end": 262.04,
   "text": "指向 PandaAI 的真实工具。",
   "film": "board"
  },
  {
   "start": 262.89,
   "end": 266.795,
   "text": "一个人也能玩：选两张 AI 物种牌当对手，",
   "film": "board"
  },
  {
   "start": 266.795,
   "end": 269.77,
   "text": "背面写着它每一场选什么、凭什么。",
   "film": "board"
  },
  {
   "start": 270.62,
   "end": 274.868,
   "text": "玩完扫档案卡上的码，手机用同一套规则，",
   "film": "board"
  },
  {
   "start": 274.868,
   "end": 276.657,
   "text": "再帮你复盘一次。",
   "film": "board"
  },
  {
   "start": 276.657,
   "end": 279.34,
   "text": "不是韭菜，那你是哪一种？",
   "film": "board"
  }
 ],
